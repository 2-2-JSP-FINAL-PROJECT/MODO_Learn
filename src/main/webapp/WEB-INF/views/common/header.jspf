<%@ page pageEncoding="UTF-8" import="com.modo.member.dto.LoginUser, com.modo.common.enums.SchoolLevel" %>
<%--
	공통 헤더 (현호작성) /

	사용법 : 각 JSP 맨 위에서
		<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
		<% request.setAttribute("pageTitle", "강의 목록"); request.setAttribute("menu", "ELEM"); %>
		<%@ include file="/WEB-INF/views/common/header.jspf" %>
			... 본문 ...
		<%@ include file="/WEB-INF/views/common/footer.jspf" %>

	menu 값 : ELEM | MIDDLE | HIGH | own | quiz | suggest | qna | notice | custom
	여기서 만든 변수 ctx, loginUser 와 메서드 h() 는 본문 JSP 와 footer 에서도 쓸 수 있다
	(같은 이름의 변수·메서드를 본문 JSP 에서 또 만들면 안 된다)
	JSP 안의 자바는 Java 11 문법까지만 쓴다 (Tomcat JSP 컴파일러 기준)
--%>
<%!
	// 화면에 출력할 글자의 < > & " ' 를 바꿔서 출력 (XSS 방지)
	private String h(String value) {
		if (value == null) return "";

		StringBuilder sb = new StringBuilder(value.length());
		for (char c : value.toCharArray()) {
			switch (c) {
			case '<':
				sb.append("&lt;");
				break;
			case '>':
				sb.append("&gt;");
				break;
			case '&':
				sb.append("&amp;");
				break;
			case '"':
				sb.append("&quot;");
				break;
			case '\'':
				sb.append("&#39;");
				break;
			default:
				sb.append(c);
			}
		}
		return sb.toString();
	}

	// 현재 메뉴면 class="on" 과 aria-current 를 붙인다
	private String on(String menu, String target) {
		return target.equals(menu) ? " class=\"on\" aria-current=\"page\"" : "";
	}
%>
<%
	String ctx = request.getContextPath();
	LoginUser loginUser = (LoginUser) session.getAttribute("loginUser");

	// 화면 제목, 현재 메뉴 (본문 JSP 에서 request.setAttribute 로 넘김)
	String pageTitle = (String) request.getAttribute("pageTitle");
	String menu = (String) request.getAttribute("menu");
	if (menu == null) menu = "";

	// 통합검색 : 검색 결과 화면에서는 입력한 검색어를 그대로 보여준다
	String searchQ = request.getParameter("q");
	String searchScope = request.getParameter("scope");
	if (searchScope == null) searchScope = "all";
%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="흩어진 초·중·고 무료 강의를 학교급·학년·과목별로 모은 큐레이션 사이트">
<title><%= pageTitle == null ? "" : h(pageTitle) + " | " %>모두의 강의실</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<link rel="stylesheet" href="<%= ctx %>/css/common.css">
<script>
	// 저장해 둔 글자 크기·고대비를 화면이 그려지기 전에 먼저 적용 (깜빡임 방지)
	(function () {
		try {
			var root = document.documentElement;
			var font = localStorage.getItem("modo.fontSize");
			if (font === "large" || font === "xlarge") root.classList.add("font-" + font);
			if (localStorage.getItem("modo.contrast") === "Y") root.classList.add("high-contrast");
		} catch (e) {
		}
	})();
</script>
<script src="<%= ctx %>/js/common.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">본문 바로가기</a>

<header class="site-header">

	<%-- ① 상단 바 : 한 줄 소개 + 접근성 · 공지 · Q&A --%>
	<div class="top-bar">
		<div class="inner">
			<p class="top-notice">
				<span class="top-badge">SDG4</span>
				돈이 없어도, 누구나 좋은 수업을 · 흩어진 무료 강의를 한곳에서
			</p>
			<ul class="top-util">
				<li>
					<button type="button" class="js-font-size" title="글자 크기 바꾸기 (보통 → 크게 → 아주 크게)">
						가<sup>+</sup> <span class="js-font-label">글자 보통</span>
					</button>
				</li>
				<li>
					<button type="button" class="js-contrast" aria-pressed="false" title="고대비 화면 켜기·끄기">
						<span aria-hidden="true">◐</span> 고대비
					</button>
				</li>
				<li><a href="<%= ctx %>/a11y">접근성 설정</a></li>
				<li><a href="<%= ctx %>/notice">공지사항</a></li>
				<li><a href="<%= ctx %>/qna">Q&amp;A</a></li>
			</ul>
		</div>
	</div>

	<%-- ② 로고 · 통합검색 · 로그인 --%>
	<div class="head-main">
		<div class="inner">
			<a class="logo" href="<%= ctx %>/main">
				<span class="logo-mark" aria-hidden="true">
					<svg viewBox="0 0 32 32" width="34" height="34">
						<rect width="32" height="32" rx="9" fill="currentColor"/>
						<path d="M8 10.5c2.6-1.2 5.3-1.2 8 0v12c-2.7-1.2-5.4-1.2-8 0z" fill="#fff"/>
						<path d="M16 10.5c2.6-1.2 5.3-1.2 8 0v12c-2.7-1.2-5.4-1.2-8 0z" fill="#fff" opacity=".75"/>
					</svg>
				</span>
				<span class="logo-text">모두의 강의실<small>초·중·고 무료 강의 큐레이션</small></span>
			</a>

			<form class="search-box" role="search" action="<%= ctx %>/search" method="get">
				<label class="sr-only" for="search-scope">검색 범위</label>
				<select id="search-scope" name="scope">
					<option value="all"<%= "all".equals(searchScope) ? " selected" : "" %>>통합검색</option>
					<option value="lecture"<%= "lecture".equals(searchScope) ? " selected" : "" %>>강의</option>
					<option value="qna"<%= "qna".equals(searchScope) ? " selected" : "" %>>Q&amp;A</option>
					<option value="notice"<%= "notice".equals(searchScope) ? " selected" : "" %>>공지사항</option>
				</select>
				<label class="sr-only" for="search-q">검색어</label>
				<input id="search-q" type="search" name="q" value="<%= h(searchQ) %>" placeholder="강의명, 강사명, 과목을 검색해 보세요." maxlength="50">
				<button type="submit" class="search-btn">
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
					<span class="sr-only">검색</span>
				</button>
			</form>

			<div class="user-menu">
<% if (loginUser == null) { %>
				<a class="user-login" href="<%= ctx %>/member/login">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
					로그인
				</a>
				<a class="btn btn-primary btn-sm" href="<%= ctx %>/member/join">회원가입</a>
<% } else { %>
				<span class="user-hello"><strong><%= h(loginUser.getName()) %></strong>님</span>
<%	if (loginUser.isAdmin()) { %>
				<a class="user-link" href="<%= ctx %>/admin">관리자 페이지</a>
<%	} else { %>
				<a class="user-link" href="<%= ctx %>/mypage">마이페이지</a>
<%	} %>
				<a class="user-link" href="<%= ctx %>/member/logout">로그아웃</a>
<% } %>
			</div>
		</div>
	</div>

	<%-- ③ 메뉴 바 : 학교급 메뉴는 SchoolLevel ENUM 으로 만든다 (마우스를 올리면 학년 펼침) --%>
	<nav class="gnb" aria-label="주 메뉴">
		<div class="inner">
			<button type="button" class="all-menu-btn" aria-expanded="false" aria-controls="all-menu">
				<span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
				<span class="sr-only">전체 메뉴</span>
			</button>

			<ul class="gnb-list">
<% for (SchoolLevel level : SchoolLevel.values()) {
	if (level == SchoolLevel.NONE) continue; %>
				<li class="has-sub">
					<a href="<%= ctx %>/lecture/list?level=<%= level.name() %>"<%= on(menu, level.name()) %>><%= level.getLabel() %></a>
					<div class="sub">
						<ul>
<%	for (int g = 1; g <= level.getMaxGrade(); g++) { %>
							<li><a href="<%= ctx %>/lecture/list?level=<%= level.name() %>&amp;grade=<%= g %>"><%= g %>학년</a></li>
<%	} %>
						</ul>
					</div>
				</li>
<% } %>
				<li><a href="<%= ctx %>/lecture/own"<%= on(menu, "own") %>>자체제작 강의</a></li>
				<li><a href="<%= ctx %>/quiz"<%= on(menu, "quiz") %>>퀴즈</a></li>
				<li><a href="<%= ctx %>/suggest"<%= on(menu, "suggest") %>>강의 추천</a></li>
				<li><a href="<%= ctx %>/qna"<%= on(menu, "qna") %>>Q&amp;A</a></li>
				<li><a href="<%= ctx %>/notice"<%= on(menu, "notice") %>>공지사항</a></li>
			</ul>

			<ul class="gnb-quick">
				<li>
					<a href="<%= ctx %>/main#custom"<%= on(menu, "custom") %>>
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3l2.6 5.6 6 .6-4.5 4 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.5-4 6-.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
						맞춤 강의
					</a>
				</li>
<% if (loginUser != null && !loginUser.isAdmin()) { %>
				<li>
					<a href="<%= ctx %>/mascot">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="13" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9.5" cy="12" r="1" fill="currentColor"/><circle cx="14.5" cy="12" r="1" fill="currentColor"/><path d="M10 15.5c1.2.8 2.8.8 4 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
						내 마스코트
					</a>
				</li>
<% } %>
				<li>
					<a href="<%= ctx %>/lecture/access">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7 13h4M13 13h4M7 10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
						자막·수어 강의
					</a>
				</li>
			</ul>
		</div>

		<%-- 전체 메뉴 (☰ 를 누르면 열림, 모바일에서는 주 메뉴 대신 이것을 쓴다) --%>
		<div id="all-menu" class="all-menu" hidden>
			<div class="inner all-menu-grid">
<% for (SchoolLevel level : SchoolLevel.values()) {
	if (level == SchoolLevel.NONE) continue; %>
				<div class="all-menu-col">
					<h2><a href="<%= ctx %>/lecture/list?level=<%= level.name() %>"><%= level.getLabel() %></a></h2>
					<ul class="grade-list">
<%	for (int g = 1; g <= level.getMaxGrade(); g++) { %>
						<li><a href="<%= ctx %>/lecture/list?level=<%= level.name() %>&amp;grade=<%= g %>"><%= g %>학년</a></li>
<%	} %>
					</ul>
				</div>
<% } %>
				<div class="all-menu-col">
					<h2>함께 배우기</h2>
					<ul>
						<li><a href="<%= ctx %>/lecture/own">자체제작 강의</a></li>
						<li><a href="<%= ctx %>/lecture/access">자막·수어 강의</a></li>
						<li><a href="<%= ctx %>/quiz">퀴즈</a></li>
						<li><a href="<%= ctx %>/suggest">강의 추천</a></li>
						<li><a href="<%= ctx %>/qna">Q&amp;A</a></li>
						<li><a href="<%= ctx %>/notice">공지사항</a></li>
					</ul>
				</div>
				<div class="all-menu-col">
					<h2>내 정보</h2>
					<ul>
<% if (loginUser == null) { %>
						<li><a href="<%= ctx %>/member/login">로그인</a></li>
						<li><a href="<%= ctx %>/member/join">회원가입</a></li>
<% } else if (loginUser.isAdmin()) { %>
						<li><a href="<%= ctx %>/admin">관리자 페이지</a></li>
						<li><a href="<%= ctx %>/member/logout">로그아웃</a></li>
<% } else { %>
						<li><a href="<%= ctx %>/mypage">마이페이지</a></li>
						<li><a href="<%= ctx %>/mascot">내 마스코트</a></li>
						<li><a href="<%= ctx %>/member/logout">로그아웃</a></li>
<% } %>
						<li><a href="<%= ctx %>/a11y">접근성 설정</a></li>
					</ul>
				</div>
			</div>
		</div>
	</nav>
</header>

<main id="main" class="site-main" tabindex="-1">
